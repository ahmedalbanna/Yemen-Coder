rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Entity Validations ---
    function isValidProfile(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'role', 'isVouched', 'rating', 'createdAt']) &&
             data.keys().size() <= 15 &&
             data.id == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 150 &&
             data.role in ['developer', 'sponsor', 'client'] &&
             data.isVouched is bool &&
             data.rating is number && data.rating >= 0 && data.rating <= 5 &&
             data.createdAt == request.time;
    }

    function isValidJob(data) {
      return data.keys().hasAll(['id', 'title', 'description', 'budget', 'currency', 'companyName', 'postedAt', 'clientId']) &&
             data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.description is string && data.description.size() > 0 && data.description.size() <= 5000 &&
             data.budget is number && data.budget >= 0 &&
             data.currency is string && data.currency.size() <= 10 &&
             data.companyName is string && data.companyName.size() <= 200 &&
             data.clientId == request.auth.uid &&
             data.postedAt == request.time;
    }

    function isValidVouch(data) {
      return data.keys().hasAll(['id', 'fromSponsorId', 'toDeveloperId', 'rating', 'createdAt']) &&
             data.fromSponsorId == request.auth.uid &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.createdAt == request.time;
    }

    // --- Collection Rules ---

    match /profiles/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && resource.data.id == request.auth.uid; // Only list own (or specific filters per pillar 8)
      
      allow create: if isVerified() && isOwner(userId) && isValidProfile(incoming()) && 
                    incoming().isVouched == false && incoming().rating == 0;
      
      allow update: if isVerified() && isOwner(userId) && 
                    isValidProfile(incoming()) && 
                    incoming().id == existing().id &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().role == existing().role &&
                    (
                      // Action: Edit Bio/Location/Skills
                      (incoming().diff(existing()).affectedKeys().hasOnly(['name', 'bio', 'location', 'skills', 'avatarUrl', 'voiceUrl']))
                    );
    }

    match /jobs/{jobId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && isValidJob(incoming()) && 
                    isValidId(jobId) &&
                    get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'client';
      
      allow update: if isVerified() && isOwner(existing().clientId) && 
                    isValidJob(incoming()) &&
                    incoming().clientId == existing().clientId &&
                    (incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'budget', 'currency', 'tags']));
      
      allow delete: if isVerified() && isOwner(existing().clientId);
    }

    match /vouches/{vouchId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && isValidVouch(incoming()) && 
                    isValidId(vouchId) &&
                    get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'sponsor' &&
                    incoming().fromSponsorId != incoming().toDeveloperId;
      // Vouches are immutable
      allow update, delete: if false;
    }

    match /transactions/{txnId} {
      allow get: if isOwner(resource.data.userId);
      // Transactions are system-managed or restricted
      allow list: if isOwner(resource.data.userId);
      allow create, update, delete: if false; // Should be handled via Admin/Server or specific gate
    }
  }
}
